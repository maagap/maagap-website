                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-4 py-2 text-left text-sm font-semibold text-gray-700">Item</th>
                        <th className="px-4 py-2 text-left text-sm font-semibold text-gray-700">Month</th>
                        <th className="px-4 py-2 text-right text-sm font-semibold text-gray-700">Amount</th>
                        <th className="px-4 py-2 text-center text-sm font-semibold text-gray-700">Status</th>
                        <th className="px-4 py-2 text-left text-sm font-semibold text-gray-700">Paid Date</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                      {billingRecords.map((record) => (
                        <tr key={record.id} className={record.status === 'paid' ? 'bg-green-50' : 'bg-red-50'}>
                          <td className="px-4 py-3 text-sm">{record.billingItemName}</td>
                          <td className="px-4 py-3 text-sm">
                            {new Date(record.month + '-01').toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
                          </td>
                          <td className="px-4 py-3 text-sm text-right font-semibold">
                            ₱{record.amount.toLocaleString('en-US', { minimumFractionDigits: 2 })}
                          </td>
                          <td className="px-4 py-3 text-center">
                            {record.status === 'paid' ? (
                              <span className="px-3 py-1 bg-green-500 text-white rounded-full text-xs font-semibold">
                                ✓ PAID
                              </span>
                            ) : (
                              <span className="px-3 py-1 bg-red-500 text-white rounded-full text-xs font-semibold">
                                ✗ UNPAID
                              </span>
                            )}
                          </td>
                          <td className="px-4 py-3 text-sm">
                            {record.paidDate ? new Date(record.paidDate).toLocaleDateString() : '-'}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                    <tfoot className="bg-gray-100">
                      <tr>
                        <td colSpan={2} className="px-4 py-3 text-sm font-semibold">Total:</td>
                        <td className="px-4 py-3 text-sm text-right font-bold">
                          ₱{billingRecords.reduce((sum, r) => sum + r.amount, 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}
                        </td>
                        <td colSpan={2} className="px-4 py-3 text-sm">
                          <span className="text-green-600 font-semibold">
                            Paid: {billingRecords.filter(r => r.status === 'paid').length}
                          </span>
                          {' / '}
                          <span className="text-red-600 font-semibold">
                            Unpaid: {billingRecords.filter(r => r.status === 'pending').length}
                          </span>
                        </td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              )}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function InfoRow({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex justify-between py-1 border-b border-gray-100">
      <span className="text-gray-600">{label}:</span>
      <span className="font-medium">{value || '-'}</span>
    </div>
  );
}
