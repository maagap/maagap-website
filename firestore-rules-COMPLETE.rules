rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is treasurer
    function isTreasurer() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'treasurer';
    }
    
    // Helper function - Admin OR Treasurer can manage finances
    function canManageFinances() {
      return request.auth != null && (isAdmin() || isTreasurer());
    }
    
    // Helper function to check if user is approved
    function isApproved() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }
    
    // Users collection - Only Admin can delete
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Members collection
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isApproved();
      allow delete: if isAdmin();
    }
    
    // Maggots collection
    match /maggots/{maggotId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isApproved();
      allow delete: if isAdmin();
    }
    
    // Transactions - Admin OR Treasurer (CREATE, UPDATE, DELETE)
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create: if canManageFinances();
      allow update: if canManageFinances();
      allow delete: if canManageFinances();
    }
    
    // Billing Items - Admin OR Treasurer (CREATE, UPDATE, DELETE)
    match /billingItems/{itemId} {
      allow read: if request.auth != null;
      allow create: if canManageFinances();
      allow update: if canManageFinances();
      allow delete: if canManageFinances();
    }
    
    // Billing Records - Admin OR Treasurer (CREATE, UPDATE, DELETE)
    match /billingRecords/{recordId} {
      allow read: if request.auth != null;
      allow create: if canManageFinances();
      allow update: if canManageFinances();
      allow delete: if canManageFinances();
    }
  }
}
